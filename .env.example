# Copernicus Data Space Ecosystem (CDSE) Credentials
# Kostenloser Account: https://dataspace.copernicus.eu/
CDSE_USERNAME=your_email@example.com
CDSE_PASSWORD=your_password

# GBIF Account (für Bulk-Downloads > 10.000 Records)
# Account erstellen: https://www.gbif.org/user/profile
GBIF_USERNAME=your_gbif_username
GBIF_PASSWORD=your_gbif_password
GBIF_EMAIL=your_email@example.com

# Testgebiet (Bounding Box in WGS84: min_lon, min_lat, max_lon, max_lat)
TEST_AREA_BBOX=16.5,48.08,16.95,48.22
TEST_AREA_NAME=Nationalpark Donau-Auen

# API Server
API_HOST=0.0.0.0
API_PORT=8000
DATA_DIR=data
